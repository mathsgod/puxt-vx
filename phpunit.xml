<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnNotice="true" failOnDeprecation="true">
    <php><ini name="error_reporting" value="-1"/></php>
    <testsuites><testsuite name="JWT regression"><directory>tests</directory></testsuite></testsuites>
    <source><include><directory>class</directory><directory>pages</directory></include></source>
</phpunit>
